<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds: HTTPS only. Certificate pins are enforced in the HTTP client
  (security/CertificatePinning.kt), with pins supplied at build time.
  This previously allowed cleartext to localhost, 10.0.2.2, 127.0.0.1 and 192.168.1.1
  in release builds too. Debug builds use src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
