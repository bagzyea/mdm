<?xml version="1.0" encoding="utf-8"?>
<!--
    Device health.

    Rebuilt for three reasons.

    The progress indicators used @android:color/holo_green_light, holo_blue_light and
    holo_orange_light — the 2011 Holo palette — with no track colour. On a light surface
    they rendered as almost-invisible hairlines, which is why the metric they existed to
    show could not be read at all.

    The labels were emoji ("🔋 Battery"). Emoji render differently on every OEM's font,
    carry no accessible label, and cannot be translated separately from the word beside
    them. They are now vector icons with content descriptions.

    Each row is icon · label · value on one line, with the bar beneath it, so the value
    sits next to what it describes rather than at the far edge of a 10" screen.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/health_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chargingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/health_charging"
                android:visibility="gone"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                app:ensureMinTouchTargetSize="false" />

        </LinearLayout>

        <!-- Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_battery"
                android:contentDescription="@string/cd_battery"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/health_battery"
                style="@style/Widget.UBOSMDM.DetailLabel" />

            <TextView
                android:id="@+id/batteryPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="85%"
                style="@style/Widget.UBOSMDM.DetailValue" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/batteryProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:progress="85"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surfaceVariant"
            app:trackStopIndicatorSize="0dp" />

        <!-- Storage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_storage"
                android:contentDescription="@string/cd_storage"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/health_storage"
                style="@style/Widget.UBOSMDM.DetailLabel" />

            <TextView
                android:id="@+id/storagePercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="45% · 64 GB free"
                style="@style/Widget.UBOSMDM.DetailValue" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/storageProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:progress="45"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surfaceVariant"
            app:trackStopIndicatorSize="0dp" />

        <!-- Memory -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_memory"
                android:contentDescription="@string/cd_memory"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/health_memory"
                style="@style/Widget.UBOSMDM.DetailLabel" />

            <TextView
                android:id="@+id/ramPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="62% · 3.0 GB free"
                style="@style/Widget.UBOSMDM.DetailValue" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ramProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="62"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surfaceVariant"
            app:trackStopIndicatorSize="0dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
