<?xml version="1.0" encoding="utf-8"?>
<!--
    UBOS MDM colour system — light.

    Every pairing used for text meets WCAG AA (4.5:1); every pairing used for a UI
    boundary or state indicator meets 3:1. That is not decoration: these tablets are used
    outdoors in direct sun, and the previous palette failed 7 of 10 key pairings — the
    "corporate apps" button was white text on #03DAC5 cyan at 1.77:1, which is
    effectively unreadable anywhere, let alone in sunlight.

    The Material-2 cyan accent is gone. It clashed with the UBOS blue and never passed.

    A full md3_* palette used to be defined here and was never referenced by the theme,
    which instead wired the older flat colours. There is now one set of names, and the
    theme uses them.

    Dark equivalents live in values-night/colors.xml. Keep the two in step: the theme is
    DayNight, so anything defined here must have a counterpart there.
-->
<resources>

    <!-- Brand -->
    <color name="primary">#0B4F9E</color>
    <color name="onPrimary">#FFFFFF</color>
    <color name="primaryContainer">#D6E3F7</color>
    <color name="onPrimaryContainer">#062A55</color>

    <color name="secondary">#4A5C74</color>
    <color name="onSecondary">#FFFFFF</color>
    <color name="secondaryContainer">#DCE4F0</color>
    <color name="onSecondaryContainer">#111C2B</color>

    <!-- Surfaces -->
    <color name="surface">#FFFFFF</color>
    <color name="onSurface">#14181F</color>
    <color name="surfaceVariant">#E6EAF1</color>
    <color name="onSurfaceVariant">#414954</color>
    <color name="background">#F6F8FB</color>
    <color name="onBackground">#14181F</color>

    <color name="outline">#6B7482</color>
    <color name="outlineVariant">#C3CAD4</color>

    <!-- State. Used for enrolment, connection and compliance, which are the only things
         an enumerator in the field actually needs to read off this device. -->
    <color name="success">#1B6B3F</color>
    <color name="onSuccess">#FFFFFF</color>
    <color name="successContainer">#CFE9D9</color>
    <color name="onSuccessContainer">#0A2E1B</color>

    <color name="warning">#8A5000</color>
    <color name="onWarning">#FFFFFF</color>
    <color name="warningContainer">#FBE6C8</color>
    <color name="onWarningContainer">#3A2100</color>

    <color name="error">#B3261E</color>
    <color name="onError">#FFFFFF</color>
    <color name="errorContainer">#F9DEDC</color>
    <color name="onErrorContainer">#410E0B</color>

    <color name="neutralContainer">#E6EAF1</color>
    <color name="onNeutralContainer">#2A313B</color>

    <color name="white">#FFFFFF</color>
    <color name="scrim">#99000000</color>
    <!-- Status aliases. The Kotlin reasons in these names (statusOnline / statusWarning
         / statusOffline); they resolve to the verified state colours above so the same
         code is correct in light and dark. -->
    <color name="statusOnline">@color/success</color>
    <color name="statusWarning">@color/warning</color>
    <color name="statusError">@color/error</color>
    <color name="statusOffline">@color/outline</color>
    <color name="statusInfo">@color/primary</color>
</resources>
