<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.UBOSMDM" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimaryDark</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/colorAccent</item>
        <item name="colorOnSecondaryContainer">@color/colorPrimaryDark</item>
        
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/colorInfo</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnTertiaryContainer">@color/colorPrimaryDark</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/backgroundCard</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorSurfaceVariant">@color/backgroundPrimary</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/backgroundPrimary</item>
        <item name="colorOnBackground">@color/textPrimary</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/colorError</item>
        <item name="colorOnErrorContainer">@color/white</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/textHint</item>
        <item name="colorOutlineVariant">@color/textHint</item>
        
        <!-- Custom attributes -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.UBOSMDM.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.UBOSMDM.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UBOSMDM.HeadlineSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.UBOSMDM.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UBOSMDM.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.UBOSMDM.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.UBOSMDM.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.UBOSMDM.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.UBOSMDM.LabelSmall</item>
    </style>

    <!-- Dark theme overrides -->
    <style name="Theme.UBOSMDM.Dark" parent="Theme.UBOSMDM">
        <item name="colorSurface">@color/backgroundCardDark</item>
        <item name="colorOnSurface">@color/textPrimaryDark</item>
        <item name="colorSurfaceVariant">@color/backgroundPrimaryDark</item>
        <item name="colorOnSurfaceVariant">@color/textSecondaryDark</item>
        <item name="android:colorBackground">@color/backgroundPrimaryDark</item>
        <item name="colorOnBackground">@color/textPrimaryDark</item>
    </style>

    <!-- Typography styles -->
    <style name="TextAppearance.UBOSMDM.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.UBOSMDM.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/textHint</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Component styles -->
    <style name="Widget.UBOSMDM.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.UBOSMDM.LabelLarge</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.UBOSMDM.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.UBOSMDM.LabelLarge</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.UBOSMDM.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/backgroundCard</item>
    </style>

    <style name="Widget.UBOSMDM.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/backgroundCard</item>
    </style>
</resources>