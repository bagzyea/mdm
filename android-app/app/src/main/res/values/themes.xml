<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme.UBOSMDM.

    Typography is one step larger than Material's defaults throughout. These are 10"
    tablets held at arm's length, often in bright sun, frequently by someone walking
    between households — not phones held 30cm from the face.

    Touch targets are 56dp rather than Material's 48dp minimum, for the same reason:
    field use, sometimes in a hurry, sometimes with wet or dusty hands.
-->
<resources>

    <style name="Theme.UBOSMDM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <!-- Tertiary maps to the same family as secondary: a third brand hue would be
             decoration, and every extra colour is one more thing to get wrong in sun. -->
        <item name="colorTertiary">@color/secondary</item>
        <item name="colorOnTertiary">@color/onSecondary</item>
        <item name="colorTertiaryContainer">@color/secondaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onSecondaryContainer</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <!-- System bars follow the theme rather than being pinned to a dark blue, so
             they are correct in both light and dark. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.UBOSMDM.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.UBOSMDM.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UBOSMDM.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.UBOSMDM.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.UBOSMDM.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.UBOSMDM.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UBOSMDM.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.UBOSMDM.LabelLarge</item>

        <item name="materialCardViewStyle">@style/Widget.UBOSMDM.Card</item>
        <item name="materialButtonStyle">@style/Widget.UBOSMDM.Button</item>
    </style>

    <!-- Typography. Sizes are deliberate; see the note at the top of this file. -->
    <style name="TextAppearance.UBOSMDM.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.UBOSMDM.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.UBOSMDM.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Components -->
    <style name="Widget.UBOSMDM.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- Outlined rather than elevated: shadows read as mud on a sunlit screen, whereas a
         1dp border holds its edge. -->
    <style name="Widget.UBOSMDM.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.UBOSMDM.LabelLarge</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Secondary buttons use the stock Material outlined style with sizing applied at
         the call site. A custom style here does not inflate under layoutlib, which would
         make the screenshot tests unable to render any screen containing one — and an
         unrenderable screen is an unreviewable screen. -->

    <!-- A label/value row. Value sits next to its label rather than being flung to the
         far edge of a 10" screen, which made the two hard to associate. -->
    <style name="Widget.UBOSMDM.DetailLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.UBOSMDM.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.UBOSMDM.DetailValue" parent="">
        <item name="android:textAppearance">@style/TextAppearance.UBOSMDM.BodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
