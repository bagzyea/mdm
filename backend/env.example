# Database Configuration
DATABASE_URL="postgresql://mdm_user:mdm_password@localhost:5432/mdm_dev"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration - REQUIRED. The server refuses to start without it.
# Must be at least 32 bytes and must not be a known placeholder value.
# Generate strong secrets using: openssl rand -base64 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"

# Encryption key for sensitive data at rest (certificate private keys).
# REQUIRED in production; derived from JWT_SECRET in development if unset.
# Accepts 64 hex chars (raw 32-byte key) or any string of >= 32 bytes.
ENCRYPTION_KEY=""

# Device credential lifetimes.
# Access tokens are short-lived; devices exchange a refresh token for a new one, and
# that exchange re-checks the device's status, giving a real revocation path.
DEVICE_ACCESS_TOKEN_TTL_SECONDS=3600
DEVICE_REFRESH_TOKEN_TTL_DAYS=90

# Public base URL used to build absolute, signed APK download links for devices.
# APKs are no longer served from an unauthenticated static path; the server mints
# short-lived signed URLs at dispatch time. If unset, links are emitted relative.
PUBLIC_BASE_URL="http://localhost:5001"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5000,http://localhost:8080"

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL="info"

# Admin User Configuration (for initial setup)
# IMPORTANT: Change the default password before deployment!
ADMIN_EMAIL="admin@mdm.local"
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"
