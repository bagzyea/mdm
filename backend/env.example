# Database Configuration
DATABASE_URL="postgresql://mdm_user:mdm_password@localhost:5432/mdm_dev"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration - MUST be changed in production
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5000,http://localhost:8080"

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL="info"

# Admin User Configuration (for initial setup)
# IMPORTANT: Change the default password before deployment!
ADMIN_EMAIL="admin@mdm.local"
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"
