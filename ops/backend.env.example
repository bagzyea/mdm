# Backend settings for ops/deploy-backend.sh. Copy to ops/backend.env (git-ignored).
NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://mdm_user:CHANGE_ME@db:5432/mdm_dev
REDIS_URL=redis://redis:6379

# Secrets: at least 32 bytes each.  openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# 64 hex chars.  openssl rand -hex 32
ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Dashboard origins. In development any private-network address on DASHBOARD_PORT is
# also allowed; production must list its origins.
ALLOWED_ORIGINS=http://10.10.10.241:5002
DASHBOARD_PORT=5002

# Where agents reach the server. PUBLIC_BASE_URL builds the signed APK download links
# sent to tablets; if unset they are relative and a tablet cannot download apps.
PUBLIC_BASE_URL=http://10.10.10.241:5001
API_BASE_URL=http://10.10.10.241:5001/api/
WEBSOCKET_URL=http://10.10.10.241:5001

# Device credentials: short access tokens, revocable refresh tokens.
DEVICE_ACCESS_TOKEN_TTL_SECONDS=3600
DEVICE_REFRESH_TOKEN_TTL_DAYS=90
# How long a queued command waits for an offline tablet (default 7 days).
COMMAND_TTL_SECONDS=604800

# Login rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Active Directory sign-in (same directory as AMS). Leave AD_SERVER empty to disable.
AD_SERVER=Athens.ubos.local
AD_DOMAIN=UBOS0
AD_BASE_DN=DC=ubos,DC=local
AD_PORT=389
AD_USE_LDAPS=false
# Create MDM accounts for unknown AD users with this role (VIEWER/OPERATOR/ADMIN).
# Leave empty so only people an administrator has added can sign in.
LDAP_AUTO_PROVISION_ROLE=

LOG_LEVEL=info

# Only for the one-off `npm run create-admin` script when bootstrapping an empty database.
# Leave blank afterwards; use ops/set-password.sh to reset a password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Behind nginx (ops/nginx-mdm.conf) ---
# The proxy whose X-Forwarded-For is believed: its address as the container sees it,
# which is the Docker gateway of the mdm_default network. Unset = off. "true" is refused.
TRUST_PROXY=172.18.0.1

# --- Sign-in throttle (services/loginThrottle.ts) ---
# Wrong passwords for one account within the window pause that account's sign-in, without
# contacting Active Directory, for LOGIN_LOCK_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
